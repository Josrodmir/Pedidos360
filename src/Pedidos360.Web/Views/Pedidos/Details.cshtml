@using System.Globalization
@model Pedido
@{ ViewData["Title"]="Detalle de pedido"; var currency = CultureInfo.InvariantCulture; }
<h1>Pedido #@Model.Id</h1><p><strong>Cliente:</strong> @Model.Cliente?.Nombre · <strong>Estado:</strong> @Model.Estado</p><table class="table"><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Descuento</th><th>Total</th></tr></thead><tbody>@foreach(var d in Model.Detalles){<tr><td>@d.Producto?.Nombre</td><td>@d.Cantidad</td><td>₡@d.PrecioUnitario.ToString("N2", currency)</td><td>@d.Descuento%</td><td>₡@d.TotalLinea.ToString("N2", currency)</td></tr>}</tbody></table><div class="text-end"><p>Subtotal: ₡@Model.Subtotal.ToString("N2", currency)</p><p>Impuestos: ₡@Model.Impuestos.ToString("N2", currency)</p><h4>Total: ₡@Model.Total.ToString("N2", currency)</h4></div><a asp-action="Index">Volver</a>
