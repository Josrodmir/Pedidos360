@model PedidoEntrada
@{ ViewData["Title"]="Nuevo pedido"; }
<div class="page-heading"><h1>Crear pedido</h1><p>Ventas agrega productos mediante búsqueda AJAX y confirma el pedido.</p></div><form asp-action="Create" id="pedidoForm"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-4"><div class="col-lg-8"><div class="panel-card p-4"><h4>Datos del pedido</h4><div class="mb-4"><label>Cliente</label><select asp-for="ClienteId" asp-items="ViewBag.ClienteId" class="form-select"><option value="">Seleccione...</option></select></div><h5>Agregar producto</h5><div class="mb-3"><input id="buscarProducto" class="form-control" placeholder="Buscar por nombre…" autocomplete="off"/><div id="resultados" class="list-group"></div></div></div><div class="table-responsive mt-4"><table class="table"><thead><tr><th>Producto</th><th>Cant.</th><th>Desc. %</th><th></th></tr></thead><tbody id="lineas"></tbody></table></div></div><div class="col-lg-4"><aside class="summary-card"><h4>Resumen</h4><p class="text-muted">Los importes se calculan en vivo.</p><div id="totales" class="fw-bold fs-5">Total: ₡0.00</div><button class="btn btn-primary w-100 mt-4">Confirmar pedido</button><p class="small mt-3 mb-0">Al confirmar se guarda el pedido, se actualiza el stock y se registra el usuario.</p></aside></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script src="~/js/pedidos.js" asp-append-version="true"></script> }
