@model IEnumerable<Pedido>
@{ ViewData["Title"]="Pedidos"; }
<div class="page-heading d-flex justify-content-between align-items-start"><div><h1>Pedidos</h1><p>Consulta y administra los pedidos confirmados.</p></div><a class="btn btn-primary" asp-action="Create">+ Nuevo pedido</a></div>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>#</th><th>Cliente</th><th>Fecha</th><th>Estado</th><th>Total</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>#P-@p.Id</td><td>@p.Cliente?.Nombre</td><td>@p.Fecha.ToLocalTime().ToString("g")</td><td><span class="status-tag">@p.Estado</span></td><td>@p.Total.ToString("C")</td><td><a asp-action="Details" asp-route-id="@p.Id">Detalle</a></td></tr>}</tbody></table></div>
