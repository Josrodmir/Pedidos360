@model IEnumerable<Pedido>
@{ ViewData["Title"]="Pedidos"; }
<div class="page-heading d-flex justify-content-between align-items-start"><div><h1>Pedidos</h1><p>Consulta y administra los pedidos confirmados.</p></div>@if (User.IsInRole("Administrador") || User.IsInRole("Ventas")){<a class="btn btn-primary" asp-action="Create">+ Nuevo pedido</a>}</div>
<form method="get" class="panel-card p-3 mb-3"><div class="row g-2 align-items-end"><div class="col-md-7"><label class="form-label" for="busqueda">Buscar pedido</label><input id="busqueda" name="busqueda" class="form-control" value="@ViewBag.Busqueda" placeholder="Cliente, estado o número #P-1" /></div><div class="col-md-auto d-flex gap-2"><button class="btn btn-outline-primary" type="submit">Buscar</button><a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a></div></div></form>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>#</th><th>Cliente</th><th>Fecha</th><th>Estado</th><th>Total</th><th></th></tr></thead><tbody>@if (Model.Any()){foreach(var p in Model){<tr><td>#P-@p.Id</td><td>@p.Cliente?.Nombre</td><td>@p.Fecha.ToLocalTime().ToString("g")</td><td><span class="status-tag">@p.Estado</span></td><td>@p.Total.ToString("C")</td><td><a asp-action="Details" asp-route-id="@p.Id">Detalle</a></td></tr>}}else{<tr><td colspan="6" class="text-center text-muted py-4">No se encontraron pedidos con ese criterio.</td></tr>}</tbody></table></div>
