@model IEnumerable<Pedido>
@{ ViewData["Title"]="Pedidos"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Pedidos</h1><a class="btn btn-primary" asp-action="Create">Nuevo pedido</a></div>
<div class="table-responsive"><table class="table table-hover"><thead><tr><th>#</th><th>Cliente</th><th>Fecha</th><th>Total</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Id</td><td>@p.Cliente?.Nombre</td><td>@p.Fecha.ToLocalTime().ToString("g")</td><td>@p.Total.ToString("C")</td><td><a asp-action="Details" asp-route-id="@p.Id">Detalle</a></td></tr>}</tbody></table></div>
