@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="panel-card p-4 p-md-5 text-center">
    <p class="text-uppercase fw-semibold text-danger small mb-2">Solicitud no completada</p>
    <h1 class="h2">No pudimos procesar esta operación.</h1>
    <p class="text-secondary mb-4">Intente nuevamente. Si el problema continúa, contacte al administrador del sistema.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Volver al inicio</a>

@if (Model.ShowRequestId)
{
    <p class="small text-secondary mt-4 mb-0">
        Código de seguimiento: <code>@Model.RequestId</code>
    </p>
}

</section>
