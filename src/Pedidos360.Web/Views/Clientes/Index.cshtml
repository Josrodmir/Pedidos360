@model ClienteIndexViewModel
@{ ViewData["Title"] = "Clientes"; }
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h2 mb-1">Clientes</h1><p class="text-secondary mb-0">Gestiona la información comercial de tus clientes.</p></div><a asp-action="Create" class="btn btn-primary">+ Nuevo cliente</a></div>
<form method="get" class="card card-body border-0 shadow-sm mb-4"><div class="row g-2 align-items-end"><div class="col-md-8"><label class="form-label" for="busqueda">Nombre o identificación</label><input name="busqueda" id="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Buscar por nombre o cédula" /></div><div class="col-md-4 d-flex gap-2"><button class="btn btn-outline-primary">Buscar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div></div></form>
@if (Model.Clientes.Count == 0) { <div class="text-center p-5 bg-light rounded-3"><h2 class="h5">No hay clientes para mostrar</h2><p class="text-secondary">Crea el primero o cambia el filtro.</p></div> }
else { <div class="table-responsive shadow-sm rounded-3"><table class="table table-hover align-middle mb-0 bg-white"><thead><tr><th>Cliente</th><th>Identificación</th><th>Correo</th><th>Teléfono</th><th class="text-end">Acciones</th></tr></thead><tbody>@foreach (var cliente in Model.Clientes) { <tr><td class="fw-semibold">@cliente.Nombre</td><td>@cliente.Cedula</td><td>@cliente.Correo</td><td>@cliente.Telefono</td><td class="text-end"><a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-secondary">Ver</a> <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-action="Delete" asp-route-id="@cliente.Id" class="btn btn-sm btn-outline-danger">Eliminar</a></td></tr> }</tbody></table></div>@if (Model.TotalPaginas > 1) { <nav class="mt-4"><ul class="pagination justify-content-center">@for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++) { <li class="page-item @(pagina == Model.PaginaActual ? "active" : "")"><a class="page-link" asp-route-pagina="@pagina" asp-route-busqueda="@Model.Busqueda">@pagina</a></li> }</ul></nav> } }
