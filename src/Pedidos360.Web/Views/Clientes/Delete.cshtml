@model Cliente
@{ ViewData["Title"] = "Eliminar cliente"; }
<div class="card border-danger shadow-sm"><div class="card-body"><h1 class="h3 text-danger">¿Eliminar cliente?</h1><p>Vas a eliminar <strong>@Model.Nombre</strong>. Esta acción no se puede deshacer.</p><form asp-action="Delete"><input type="hidden" asp-for="Id" /><button class="btn btn-danger">Eliminar</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form></div></div>
