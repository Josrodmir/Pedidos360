@model Producto
@{ ViewData["Title"] = "Detalle de producto"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 mb-0">@Model.Nombre</h1>
    @if (User.IsInRole("Administrador") || User.IsInRole("Inventario"))
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
    }
</div>
<div class="card shadow-sm border-0"><div class="card-body row g-4"><div class="col-md-4">@if (Model.ImagenBytes is { Length: > 0 }) { <img src="@Url.Action("Imagen", new { id = Model.Id })" class="img-fluid rounded" alt="@Model.Nombre" /> } else { <div class="bg-light rounded p-4 text-secondary">Este producto aún no tiene una imagen cargada en la base de datos.</div> }</div><div class="col-md-8"><dl class="row mb-0"><dt class="col-sm-4">Categoría</dt><dd class="col-sm-8">@Model.Categoria?.Nombre</dd><dt class="col-sm-4">Precio</dt><dd class="col-sm-8">₡@Model.Precio.ToString("N2")</dd><dt class="col-sm-4">Impuesto</dt><dd class="col-sm-8">@Model.ImpuestoPorc%</dd><dt class="col-sm-4">Stock</dt><dd class="col-sm-8">@Model.Stock</dd><dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@(Model.Activo ? "Activo" : "Inactivo")</dd></dl></div></div></div><a asp-action="Index" class="btn btn-link mt-3">← Volver al catálogo</a>
<div class="mt-3 d-flex gap-2 align-items-center">
    @if (User.IsInRole("Administrador") || User.IsInRole("Ventas"))
    {
        <a class="btn btn-primary" asp-controller="Pedidos" asp-action="Create">Crear pedido</a>
    }
    else if (!(User.Identity?.IsAuthenticated ?? false))
    {
        <a class="btn btn-primary" asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Details", "Productos", new { id = Model.Id })">Iniciar sesión para comprar</a>
    }
    else
    {
        <span class="text-muted small">Su rol no tiene permiso para crear pedidos.</span>
    }
    <a asp-action="Index" class="btn btn-link">← Volver al catálogo</a>
</div>
