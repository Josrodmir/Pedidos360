@model Producto
@{ ViewData["Title"] = "Detalle de producto"; }
<div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h2 mb-0">@Model.Nombre</h1><a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a></div>
<div class="card shadow-sm border-0"><div class="card-body row g-4"><div class="col-md-4">@if (!string.IsNullOrWhiteSpace(Model.ImagenUrl)) { <img src="@Model.ImagenUrl" class="img-fluid rounded" alt="@Model.Nombre" /> }</div><div class="col-md-8"><dl class="row mb-0"><dt class="col-sm-4">Categoría</dt><dd class="col-sm-8">@Model.Categoria?.Nombre</dd><dt class="col-sm-4">Precio</dt><dd class="col-sm-8">₡@Model.Precio.ToString("N2")</dd><dt class="col-sm-4">Impuesto</dt><dd class="col-sm-8">@Model.ImpuestoPorc%</dd><dt class="col-sm-4">Stock</dt><dd class="col-sm-8">@Model.Stock</dd><dt class="col-sm-4">Estado</dt><dd class="col-sm-8">@(Model.Activo ? "Activo" : "Inactivo")</dd></dl></div></div></div><a asp-action="Index" class="btn btn-link mt-3">← Volver al catálogo</a>
