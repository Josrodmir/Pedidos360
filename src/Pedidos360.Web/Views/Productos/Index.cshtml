@model ProductoIndexViewModel
@{ ViewData["Title"] = "Productos"; }

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div><h1 class="h2 mb-1">Catálogo de productos</h1><p class="text-secondary mb-0">Administra precios, inventario y categorías.</p></div>
    <a asp-action="Create" class="btn btn-primary">+ Nuevo producto</a>
</div>

<form method="get" class="card card-body border-0 shadow-sm mb-4">
    <div class="row g-2 align-items-end">
        <div class="col-md-5"><label class="form-label" for="busqueda">Nombre</label><input name="busqueda" id="busqueda" value="@Model.Busqueda" class="form-control" placeholder="Buscar producto" /></div>
        <div class="col-md-4"><label class="form-label" for="categoriaId">Categoría</label><select name="categoriaId" id="categoriaId" class="form-select"><option value="">Todas las categorías</option>@foreach (var categoria in Model.Categorias) { <option value="@categoria.Id" selected="@(Model.CategoriaId == categoria.Id)">@categoria.Nombre</option> }</select></div>
        <div class="col-md-3 d-flex gap-2"><button class="btn btn-outline-primary">Filtrar</button><a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a></div>
    </div>
</form>

@if (Model.Productos.Count == 0)
{
    <div class="text-center p-5 bg-light rounded-3"><h2 class="h5">No hay productos para mostrar</h2><p class="text-secondary">Crea el primero o cambia los filtros.</p></div>
}
else
{
    <div class="table-responsive shadow-sm rounded-3"><table class="table table-hover align-middle mb-0 bg-white"><thead><tr><th>Producto</th><th>Categoría</th><th>Precio</th><th>Impuesto</th><th>Stock</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead><tbody>
    @foreach (var producto in Model.Productos) { <tr><td class="fw-semibold">@producto.Nombre</td><td>@producto.Categoria?.Nombre</td><td>₡@producto.Precio.ToString("N2")</td><td>@producto.ImpuestoPorc%</td><td>@producto.Stock</td><td><span class="badge @(producto.Activo ? "text-bg-success" : "text-bg-secondary")">@(producto.Activo ? "Activo" : "Inactivo")</span></td><td class="text-end"><a asp-action="Details" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-secondary">Ver</a> <a asp-action="Edit" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-primary">Editar</a> <a asp-action="Delete" asp-route-id="@producto.Id" class="btn btn-sm btn-outline-danger">Eliminar</a></td></tr> }
    </tbody></table></div>
    @if (Model.TotalPaginas > 1)
    {
        <nav class="mt-4"><ul class="pagination justify-content-center">@for (var pagina = 1; pagina <= Model.TotalPaginas; pagina++) { <li class="page-item @(pagina == Model.PaginaActual ? "active" : "")"><a class="page-link" asp-route-pagina="@pagina" asp-route-busqueda="@Model.Busqueda" asp-route-categoriaId="@Model.CategoriaId">@pagina</a></li> }</ul></nav>
    }
}
