@model Producto

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="Nombre" class="form-label"></label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CategoriaId" class="form-label"></label>
        <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-select">
            <option value="">Seleccione una categoría</option>
        </select>
        <span asp-validation-for="CategoriaId" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Precio" class="form-label"></label>
        <input asp-for="Precio" class="form-control" min="0.01" step="0.01" />
        <span asp-validation-for="Precio" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ImpuestoPorc" class="form-label"></label>
        <input asp-for="ImpuestoPorc" class="form-control" min="0" max="100" step="0.01" />
        <span asp-validation-for="ImpuestoPorc" class="text-danger"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Stock" class="form-label"></label>
        <input asp-for="Stock" class="form-control" min="0" />
        <span asp-validation-for="Stock" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="ImagenArchivo" class="form-label"></label>
        <input asp-for="ImagenArchivo" type="file" class="form-control" accept="image/jpeg,image/png,image/webp" />
        <div class="form-text">JPG, PNG o WEBP. Tamaño máximo: 2 MB. Al editar, deje vacío este campo para conservar la imagen actual.</div>
        <span asp-validation-for="ImagenArchivo" class="text-danger"></span>
    </div>
    <div class="col-12">
        <div class="form-check form-switch">
            <input asp-for="Activo" class="form-check-input" />
            <label asp-for="Activo" class="form-check-label"></label>
        </div>
    </div>
</div>
